    {
      "id": "get-files",
      "name": "Get PR Files",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        672,
        -100
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $json.repo_owner }}/{{ $json.repo_name }}/pulls/{{ $json.pr_number }}/files",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "Authorization",
              "value": "token {{ env.GITHUB_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "typeVersion": 4.3
    },
    {
      "id": "analyze-files",
      "name": "Analyze Files",
      "type": "n8n-nodes-base.code",
      "position": [
        896,
        -100
      ],
      "parameters": {
        "jsCode": "const config = $('Configuration').first().json;\nconst items = $input.all();\n\n// Extract JSON from all items\nconst fileList = items.map(item => item.json);\n\n// Categorize files\nconst codeFiles = [];\nconst docFiles = [];\nconst configFiles = [];\n\nfor (const file of fileList) {\n  const path = file.filename || '';\n  const ext = path.split('.').pop()?.toLowerCase() || '';\n  \n  if (path.startsWith('docs/') || path.endsWith('.md') || path.endsWith('.rst')) {\n    docFiles.push({ path, status: file.status, changes: file.changes });\n  } else if (['py', 'js', 'ts', 'jsx', 'tsx', 'java', 'go', 'rs'].includes(ext)) {\n    codeFiles.push({ path, status: file.status, changes: file.changes, patch: file.patch?.slice(0, 500) });\n  } else if (['json', 'yaml', 'yml', 'toml', 'ini', 'env'].includes(ext) || path.includes('config')) {\n    configFiles.push({ path, status: file.status, changes: file.changes });\n  }\n}\n\nreturn {\n  ...config,\n  total_files: fileList.length,\n  code_files: codeFiles,\n  doc_files: docFiles,\n  config_files: configFiles,\n  code_changed: codeFiles.length > 0,\n  docs_included: docFiles.length > 0,\n  summary: `${codeFiles.length} code, ${docFiles.length} docs, ${configFiles.length} config files`\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "ai-analysis",
      "name": "AI Doc Impact Analysis",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1120,
        -100
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this Pull Request for documentation impact.\n\nPR Title: {{ $json.pr_title }}\nPR Author: {{ $json.pr_author }}\n\nCode files changed ({{ $json.code_files.length }}):\n{{ $json.code_files.map(f => '- ' + f.path + ' (' + f.status + ', ' + f.changes + ' changes)').join('\\n') || 'None' }}\n\nDoc files changed ({{ $json.doc_files.length }}):\n{{ $json.doc_files.map(f => '- ' + f.path + ' (' + f.status + ')').join('\\n') || 'None' }}\n\nConfig files changed ({{ $json.config_files.length }}):\n{{ $json.config_files.map(f => '- ' + f.path).join('\\n') || 'None' }}\n\nCode patches (truncated):\n{{ $json.code_files.slice(0, 3).map(f => '### ' + f.path + '\\n```\\n' + (f.patch || 'No patch available') + '\\n```').join('\\n\\n') }}\n\nRespond with JSON only:\n{\n  \"needs_doc_update\": true,\n  \"confidence\": 0.9,\n  \"affected_docs\": [\"list of docs\"],\n  \"suggestions\": [\"suggestions\"],\n  \"summary\": \"summary\"\n}"
      },
      "typeVersion": 3
    },
    {
      "id": "gemini",
      "name": "Gemini Chat",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "position": [
        1120,
        100
      ],
      "parameters": {
        "modelName": "models/gemini-2.0-flash-exp",
        "options": {}
      },
      "credentials": {
        "googlePalmApi": {
          "id": "kJmLsDFHzgrlPJhY",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "typeVersion": 1
    },
    {
      "id": "parse-response",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "position": [
        1344,
        -100
      ],
      "parameters": {
        "jsCode": "const config = $('Analyze Files').first().json;\nconst response = $input.first().json;\nconst text = response.output || response.text || JSON.stringify(response);\n\nlet analysis;\ntry {\n  const jsonMatch = text.match(/```json\\n?([\\s\\S]*?)\\n?```/) || text.match(/\\{[\\s\\S]*\\}/);\n  analysis = JSON.parse(jsonMatch ? (jsonMatch[1] || jsonMatch[0]) : text);\n} catch (e) {\n  analysis = {\n    needs_doc_update: false,\n    confidence: 0.3,\n    affected_docs: [],\n    suggestions: [],\n    summary: 'Could not parse AI response'\n  };\n}\n\nreturn {\n  ...config,\n  needs_doc_update: analysis.needs_doc_update === true,\n  confidence: analysis.confidence || 0.5,\n  affected_docs: analysis.affected_docs || [],\n  suggestions: analysis.suggestions || [],\n  ai_summary: analysis.summary || 'Analysis complete'\n};"
      },
      "typeVersion": 2
    },
    {
      "id": "has-impact",
      "name": "Has Doc Impact?",
      "type": "n8n-nodes-base.if",
      "position": [
        1568,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "impact-check",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.needs_doc_update === true && $json.confidence >= 0.6 }}"
            }
          ]
        },
        "options": {}
      },
      "typeVersion": 2.2
    },
    {
      "id": "post-comment",
      "name": "Post Review Comment",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1792,
        -180
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/{{ $json.repo_owner }}/{{ $json.repo_name }}/pulls/{{ $json.pr_number }}/reviews",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "Authorization",
              "value": "token {{ env.GITHUB_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"body\": \"## 📚 Documentation Review\\n\\n**AI Analysis** (confidence: {{ ($json.confidence * 100).toFixed(0) }}%)\\n\\n{{ $json.ai_summary }}\\n\\n### Affected Documentation\\n\\n{{ $json.affected_docs.length > 0 ? $json.affected_docs.map(d => '- `' + d + '`').join('\\\\n') : 'No specific docs identified' }}\\n\\n### Suggestions\\n\\n{{ $json.suggestions.length > 0 ? $json.suggestions.map((s, i) => (i+1) + '. ' + s).join('\\\\n') : 'No specific suggestions' }}\\n\\n---\\n*This review was generated automatically by Doc Chain - PR Review*\",\n  \"event\": \"COMMENT\"\n}",
        "options": {}
      },
      "typeVersion": 4.3
    },
    {
      "id": "log-no-action",
      "name": "Log No Action",
      "type": "n8n-nodes-base.code",
      "position": [
        1792,
        -20
      ],
      "parameters": {
        "jsCode": "return {\n  status: 'no_action',\n  pr_number: $json.pr_number,\n  pr_title: $json.pr_title,\n  reason: $json.needs_doc_update ? 'low_confidence' : 'no_doc_impact',\n  confidence: $json.confidence,\n  summary: $json.ai_summary\n};"
      },
      "typeVersion": 2
    }
