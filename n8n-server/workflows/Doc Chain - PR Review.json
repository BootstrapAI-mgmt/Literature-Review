          "jsCode": "const config = $('Analyze Files').first().json;\nconst response = $input.first().json;\nconst text = response.output || response.text || JSON.stringify(response);\n\nlet analysis;\ntry {\n  const jsonMatch = text.match(/```json\\n?([\\s\\S]*?)\\n?```/) || text.match(/\\{[\\s\\S]*\\}/);\n  analysis = JSON.parse(jsonMatch ? (jsonMatch[1] || jsonMatch[0]) : text);\n} catch (e) {\n  analysis = {\n    needs_doc_update: false,\n    confidence: 0.3,\n    affected_docs: [],\n    suggestions: [],\n    summary: 'Could not parse AI response'\n  };\n}\n\nreturn {\n  ...config,\n  needs_doc_update: analysis.needs_doc_update === true,\n  confidence: analysis.confidence || 0.5,\n  affected_docs: analysis.affected_docs || [],\n  suggestions: analysis.suggestions || [],\n  ai_summary: analysis.summary || 'Analysis complete'\n};"
