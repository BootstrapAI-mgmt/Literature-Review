{
  "name": "Doc Chain - Errors",
  "nodes": [
    {
      "parameters": {},
      "id": "3de8134a-e845-4242-a486-3075116bcca6",
      "name": "Catch Errors",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const error = $input.first().json;\n\nlet task_id = null;\nconst findTaskId = (obj, depth = 0) => {\n  if (!obj || typeof obj !== 'object' || depth > 20) return null;\n  \n  // Highest reliability: custom header\n  if (obj.headers) {\n    if (obj.headers['X-N8N-Task-ID']) return obj.headers['X-N8N-Task-ID'];\n    if (obj.headers['x-n8n-task-id']) return obj.headers['x-n8n-task-id'];\n  }\n  \n  // Explicit fields\n  if (obj.task_id) return obj.task_id;\n  if (obj.task && obj.task.task_id) return obj.task.task_id;\n  if (obj.workflow_config && obj.workflow_config.task_id) return obj.workflow_config.task_id;\n\n  // Recursive search in all properties\n  for (const key in obj) {\n    if (key === 'workflow') continue; // Skip large metadata, but KEEP execution\n    const val = obj[key];\n    if (typeof val === 'object' && val !== null) {\n      const res = findTaskId(val, depth + 1);\n      if (res) return res;\n    } else if (key.toLowerCase() === 'task_id') {\n      return val;\n    }\n  }\n  return null;\n};\n\ntask_id = findTaskId(error);\n\nconst bodyLines = [\n  '## Automated Error Report',\n  '',\n  `**Workflow:** ${error.workflow?.name || 'Unknown'}`,\n  `**Failed Node:** ${error.execution?.lastNodeExecuted || 'Unknown'}`,\n  `**Timestamp:** ${new Date().toISOString()}`,\n  '',\n  '### Error Message',\n  '```',\n  error.execution?.error?.message || 'Unknown error',\n  '```',\n  '',\n  task_id ? `**Task ID:** \\`${task_id}\\`` : '🔴 **No task ID recovered**',\n  '',\n  '### Raw Error Object (Truncated)',\n  '```json',\n  JSON.stringify(error, (key, value) => (key === 'workflowPublishHistory' ? undefined : value), 2).slice(0, 5000),\n  '```',\n  '',\n  '---\\n*This issue was automatically created by the Error Handler workflow.*'\n];\n\nreturn {\n  workflow: error.workflow?.name || 'Unknown',\n  node: error.execution?.lastNodeExecuted || 'Unknown',\n  message: error.execution?.error?.message || 'Unknown error',\n  task_id: task_id,\n  issue_body: bodyLines.join('\\n')\n};"
      },
      "id": "4eb59ced-85b3-45fa-a72f-88043eb421c9",
      "name": "Log Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
