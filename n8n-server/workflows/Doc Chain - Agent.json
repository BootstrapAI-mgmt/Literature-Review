      {
        "parameters": {
          "jsCode": "// The Distributor sends task/trigger as JSON strings - parse them back to objects\nconst body = $input.first().json.body;\n\n// Safely parse task with fallback to empty object\nlet task = {};\nif (body.task) {\n  task = typeof body.task === 'string' ? JSON.parse(body.task) : body.task;\n}\n\n// Safely parse trigger with fallback to empty object\nlet trigger = {};\nif (body.trigger) {\n  trigger = typeof body.trigger === 'string' ? JSON.parse(body.trigger) : body.trigger;\n}\n\n// Clean up list_id\nconst listId = typeof body.list_id === 'string' ? body.list_id.replace(/\"/g, '') : (body.list_id || '');\n\n// Normalize field names: State Reconciliation uses \"target\", Trigger uses \"document\"\nif (task && task.target && !task.document) {\n  task.document = task.target;\n}\n\nreturn { task, trigger, list_id: listId };"
        },
