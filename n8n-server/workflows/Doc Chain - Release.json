    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo_owner }}/{{ $json.repo_name }}/releases",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"tag_name\": \"{{ $json.tag }}\",\n  \"name\": \"{{ $json.tag }}\",\n  \"body\": {{ JSON.stringify($json.changelog) }},\n  \"draft\": false,\n  \"prerelease\": {{ $json.tag.includes('-') }}\n}",
        "options": {},
        "method": "POST"
      },
      "id": "create-release",
      "name": "Create GitHub Release",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1568,
        -80
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Ho5S7HOxBPdmEAL0",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const release = $input.first().json;\nconst changelog = $('Generate Changelog').first().json;\n\nreturn {\n  status: 'success',\n  release_url: release.html_url,\n  tag: changelog.tag,\n  commit_count: changelog.commit_count,\n  message: `Release ${changelog.tag} created successfully`\n};"
      },
      "id": "success-log",
      "name": "Log Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "return {\n  status: 'error',\n  message: $('Parse Tags').first().json.error || 'No valid tags found',\n  tag: null\n};"
      },
      "id": "error-log",
      "name": "Log Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        80
      ]
    }
