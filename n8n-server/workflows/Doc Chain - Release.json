      "id": "get-tags",
      "name": "Get Recent Tags",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        448,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Ho5S7HOxBPdmEAL0",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const config = $('Configuration').first().json;\nconst tags = $input.first().json;\n\n// Handle case where tags is an array\nconst tagList = Array.isArray(tags) ? tags : [];\n\nif (tagList.length === 0) {\n  return {\n    error: 'No tags found in repository',\n    current_tag: null,\n    previous_tag: null\n  };\n}\n\n// If specific tag requested, find it; otherwise use latest\nlet currentTag, previousTag;\nif (config.tag === 'latest') {\n  currentTag = tagList[0];\n  previousTag = tagList[1] || null;\n} else {\n  const tagIndex = tagList.findIndex(t => t.name === config.tag);\n  if (tagIndex === -1) {\n    return {\n      error: `Tag ${config.tag} not found`,\n      current_tag: null,\n      previous_tag: null\n    };\n  }\n  currentTag = tagList[tagIndex];\n  previousTag = tagList[tagIndex + 1] || null;\n}\n\nreturn {\n  current_tag: currentTag.name,\n  current_sha: currentTag.commit?.sha,\n  previous_tag: previousTag?.name || null,\n  previous_sha: previousTag?.commit?.sha || null,\n  repo_owner: config.repo_owner,\n  repo_name: config.repo_name\n};"
      },
      "id": "parse-tags",
      "name": "Parse Tags",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-tags",
              "leftValue": "={{ $json.current_tag !== null }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-tags-check",
      "name": "Has Tags?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        896,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo_owner }}/{{ $json.repo_name }}/compare/{{ $json.previous_sha || $json.current_sha + '~10' }}...{{ $json.current_sha }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "get-commits",
      "name": "Get Commits Since Previous",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1120,
        -80
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Ho5S7HOxBPdmEAL0",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const tagInfo = $('Parse Tags').first().json;\nconst comparison = $input.first().json;\nconst commits = comparison.commits || [];\n\n// Categorize commits by conventional commit type\nconst categories = {\n  feat: { title: '\u2728 Features', items: [] },\n  fix: { title: '\ud83d\udc1b Bug Fixes', items: [] },\n  docs: { title: '\ud83d\udcda Documentation', items: [] },\n  chore: { title: '\ud83d\udd27 Maintenance', items: [] },\n  refactor: { title: '\u267b\ufe0f Refactoring', items: [] },\n  test: { title: '\ud83e\uddea Tests', items: [] },\n  other: { title: '\ud83d\udcdd Other Changes', items: [] }\n};\n\nfor (const commit of commits) {\n  const message = commit.commit?.message?.split('\\n')[0] || '';\n  \n  // Skip merge commits and n8n automated commits\n  if (message.startsWith('Merge ') || message.startsWith('[n8n]')) continue;\n  \n  const match = message.match(/^(\\w+)(\\([^)]+\\))?:\\s*(.+)/);\n  if (match) {\n    const type = match[1].toLowerCase();\n    const scope = match[2] || '';\n    const desc = match[3];\n    const category = categories[type] || categories.other;\n    category.items.push(`- ${scope}${desc} (${commit.sha?.slice(0, 7)})`);\n  } else {\n    categories.other.items.push(`- ${message} (${commit.sha?.slice(0, 7)})`);\n  }\n}\n\n// Build changelog markdown\nlet changelog = `# Release ${tagInfo.current_tag}\\n\\n`;\nif (tagInfo.previous_tag) {\n  changelog += `**Full Changelog**: ${tagInfo.previous_tag}...${tagInfo.current_tag}\\n\\n`;\n}\n\nfor (const [key, cat] of Object.entries(categories)) {\n  if (cat.items.length > 0) {\n    changelog += `## ${cat.title}\\n\\n${cat.items.join('\\n')}\\n\\n`;\n  }\n}\n\nchangelog += `---\\n*Generated automatically by Doc Chain - Release workflow*`;\n\nreturn {\n  tag: tagInfo.current_tag,\n  previous_tag: tagInfo.previous_tag,\n  commit_count: commits.length,\n  changelog: changelog,\n  repo_owner: tagInfo.repo_owner,\n  repo_name: tagInfo.repo_name\n};"
      },
      "id": "generate-changelog",
      "name": "Generate Changelog",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        -80
