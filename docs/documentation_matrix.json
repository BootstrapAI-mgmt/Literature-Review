  "state_reconciliation": {
    "description": "Configuration for ensuring repository reflects current state of all tasks/roadmaps",
    "enabled": true,
    "schedule": {
      "frequency": "daily",
      "hour_utc": 4,
      "description": "Runs after staleness review to reconcile state across documents"
    },
    "rollup_targets": {
      "task_cards_to_indexes": {
        "source_patterns": [
          "task-cards/**/*.md"
        ],
        "target_documents": [
          "task-cards/README.md",
          "task-cards/INDEX.md"
        ],
        "aggregation": "count_by_status",
        "description": "Count completed vs total task cards and update index percentages"
      },
      "indexes_to_roadmap": {
        "source_patterns": [
          "task-cards/README.md",
          "task-cards/INDEX.md",
          "task-cards/*/README.md"
        ],
        "target_documents": [
          "docs/CONSOLIDATED_ROADMAP.md"
        ],
        "aggregation": "summarize_progress",
        "description": "Roll up index completion percentages to master roadmap"
      },
      "status_reports_to_roadmap": {
        "source_patterns": [
          "docs/status-reports/*.md"
        ],
        "target_documents": [
          "docs/CONSOLIDATED_ROADMAP.md"
        ],
        "aggregation": "latest_status",
        "description": "Extract current status from reports to update roadmap"
      }
    },
    "status_extraction_patterns": {
      "task_card_status": "^Status:\\s*(.+)$",
      "completion_percentage": "(\\d+)%\\s*(?:complete|done)",
      "checkbox_count": "- \\[([x ])\\]",
      "wave_status": "^##\\s*Wave\\s*\\d+.*Status:\\s*(.+)$"
    }
  },
  "task_status_mappings": {
    "status_values": [
      "Not Started",
      "In Progress",
      "Complete",
      "Blocked",
      "Deferred"
    ],
    "checkbox_patterns": {
      "unchecked": "- [ ]",
      "checked": "- [x]"
    },
    "status_emoji": {
      "Not Started": "🟢 Ready",
      "In Progress": "🔄 Active",
      "Complete": "✅ COMPLETE",
      "Blocked": "🔴 Blocked",
      "Deferred": "🟡 Deferred"
    },
    "completion_triggers": [
      "Status: Complete",
      "Status: ✅ COMPLETE",
      "**Status:** Complete"
    ]
  },
  "field_descriptions": {
    "created_date": "Date the document was first created (from git history)",
    "last_reviewed": "Date the document was last reviewed by human or AI agent",
    "next_review": "Calculated date for next scheduled review",
    "review_interval_days": "Per-document override for review frequency (defaults to domain setting)"
  }
}