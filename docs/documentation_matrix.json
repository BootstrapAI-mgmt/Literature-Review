{
  "version": "1.3",
  "last_updated": "2025-12-11",
  "description": "Machine-readable documentation dependency matrix with staleness detection support",
  "staleness_config": {
    "enabled": true,
    "default_review_interval_days": 7,
    "max_inactivity_before_alert_days": 21,
    "thresholds": {
      "auto_update": 0.7,
      "manual_review": 0.5,
      "create_issue": 0.3,
      "healthy": 0
    },
    "ignore_patterns": [
      "test_*.py",
      "tests/**",
      "*.md"
    ],
    "schedule": {
      "frequency": "weekly",
      "day": "sunday",
      "hour_utc": 2,
      "stagger_domains": false
    },
    "notifications": {
      "create_github_issues": true,
      "issue_labels": [
        "documentation",
        "staleness-review",
        "automated"
      ],
      "digest_enabled": true
    }
  },
  "status_codes": {
    "current": "Up-to-date with latest code",
    "review": "May need updates, should review against current code",
    "complete": "Feature complete and stable",
    "pending": "Planned but not implemented",
    "archivable": "Historical, can be moved to archive",
    "superseded": "Replaced by newer documentation"
  },
  "priority_levels": {
    "L1": "Core documentation - update first, cascades to L2-L3",
    "L2": "Feature documentation - may cascade to L3",
    "L3": "Reference/historical - terminal, no cascade"
  },
  "owner_domains": {
    "@core": {
      "documents": [
        "README.md",
        "docs/USER_MANUAL.md"
      ],
      "review_interval_days": 7,
      "priority": "high",
      "staleness_indicators": [
        "pipeline_orchestrator.py",
        "webdashboard/app.py"
      ]
    },
    "@dashboard": {
      "documents": [
        "docs/DASHBOARD_GUIDE.md",
        "docs/DASHBOARD_CLI_PARITY.md"
      ],
